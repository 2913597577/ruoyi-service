<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.performance.mapper.DcCustomerPerformanceMapper">

    <select id="selectUserPerformanceRank" resultType="map">
        SELECT
        userId,
        username,
        monthBalance,
        performanceRank
        FROM (
        SELECT
        user_id as userId,
        user_name as username,
        SUM(balance) as monthBalance,
        RANK() OVER (ORDER BY SUM(balance) DESC) as performanceRank
        FROM
        dc_customer_performance
        WHERE
        del_flag = 0
        <if test="year != null">
            AND YEAR(create_time) = #{year}
        </if>
        <if test="month != null">
            AND MONTH(create_time) = #{month}
        </if>
        <if test="year == null and month == null">
            AND create_time BETWEEN DATE_FORMAT(CURDATE(), '%Y-%m-01') AND LAST_DAY(CURDATE())
        </if>
        GROUP BY
        user_id,
        user_name
        ) ranked_data
        <if test="userId != null">
            WHERE userId = #{userId}
        </if>
    </select>

    <select id="selectListByPage" resultType="map">
        SELECT p.*,
        t.company_name as companyName,
        t.customer_city as serviceCity,
        t.inviter_id as inviterId,
        t.service_type as serviceType,
        t.second_development_type as secondDevelopmentType,
        t.service_start as serviceStart,
        t.service_end as serviceEnd
        FROM dc_customer_performance p
        left join dc_customer_transfer t
        ON p.transfer_id = t.id
        WHERE p.del_flag = 0 AND t.del_flag = 0
        <if test="userId != null and userId.size() > 0">
            AND p.user_id IN
            <foreach collection="userId" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="transferId != null and transferId.size() > 0">
            AND p.transfer_id IN
            <foreach collection="transferId" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="city != null and city.size() > 0">
            AND p.city IN
            <foreach collection="city" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="serviceCity != null and serviceCity.size() > 0">
            AND t.customer_city IN
            <foreach collection="serviceCity" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="inviterId != null and inviterId.size() > 0">
            AND t.inviter_id IN
            <foreach collection="inviterId" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="serviceType != null and serviceType.size() > 0">
            AND t.service_type IN
            <foreach collection="serviceType" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="secondDevelopmentType != null and secondDevelopmentType.size() > 0">
            AND p.second_service_type IN
            <foreach collection="secondDevelopmentType" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="serviceStart != null">
            AND DATE(t.service_start) = #{serviceStart}
        </if>
        <if test="serviceEnd != null">
            AND DATE(t.service_end) = #{serviceEnd}
        </if>
        <if test="companyName != null and companyName.size() > 0">
            AND t.company_name IN
            <foreach collection="companyName" item="name" open="(" separator="," close=")">
                #{name}
            </foreach>
        </if>
        order by p.create_time desc
        <if test="page != null and pageSize != null">
            LIMIT #{page},#{pageSize}
        </if>
    </select>

    <select id="selectListByPageCount" resultType="int">
        SELECT COUNT(*)
        FROM dc_customer_performance p
        left join dc_customer_transfer t
        ON p.transfer_id = t.id
        WHERE p.del_flag = 0 AND t.del_flag = 0
        <if test="userId != null and userId.size() > 0">
            AND p.user_id IN
            <foreach collection="userId" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="transferId != null and transferId.size() > 0">
            AND p.transfer_id IN
            <foreach collection="transferId" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="city != null and city.size() > 0">
            AND p.city IN
            <foreach collection="city" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="serviceCity != null and serviceCity.size() > 0">
            AND t.customer_city IN
            <foreach collection="serviceCity" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="inviterId != null and inviterId.size() > 0">
            AND t.inviter_id IN
            <foreach collection="inviterId" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="serviceType != null and serviceType.size() > 0">
            AND t.service_type IN
            <foreach collection="serviceType" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="secondDevelopmentType != null and secondDevelopmentType.size() > 0">
            AND p.second_service_type IN
            <foreach collection="secondDevelopmentType" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        <if test="serviceStart != null">
            AND DATE(t.service_start) = #{serviceStart}
        </if>
        <if test="serviceEnd != null">
            AND DATE(t.service_end) <![CDATA[ <= ]]> #{serviceEnd}
        </if>
        <if test="companyName != null and companyName.size() > 0">
            AND t.company_name IN
            <foreach collection="companyName" item="name" open="(" separator="," close=")">
                #{name}
            </foreach>
        </if>
    </select>


</mapper>
