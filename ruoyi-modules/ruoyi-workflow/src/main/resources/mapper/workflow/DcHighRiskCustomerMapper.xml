<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.workflow.mapper.DcHighRiskCustomerMapper">

    <update id="updateRiskTypeById">
        UPDATE dc_customer_information
        SET is_high_risk = #{isHighRisk}
        WHERE id = #{id}
    </update>

</mapper>
